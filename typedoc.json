{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.tsx", "src/sound/api.ts"],
  "tsconfig": "tsconfig.build.json",
  "out": "docs/api",
  "cleanOutputDir": true,
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "docsRoot": ".",
  "sidebar": { "collapsed": true, "pretty": true },
  "readme": "none",
  "entryFileName": "index",
  "indexFormat": "table",
  "parametersFormat": "table",
  "interfacePropertiesFormat": "table",
  "classPropertiesFormat": "table",
  "typeDeclarationFormat": "table",
  "hideBreadcrumbs": true,
  "hidePageHeader": true,
  "pageTitleTemplates": { "index": "API reference" },
  "tableColumnSettings": { "hideSources": true },
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "sort": ["source-order"],
  "sourceLinkTemplate": "https://github.com/rmotafreitas/react-native-anything-player/blob/{gitRevision}/{path}#L{line}",
  "validation": { "notExported": true, "invalidLink": true, "notDocumented": true },
  "treatWarningsAsErrors": true
}
