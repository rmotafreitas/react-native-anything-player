{
  "name": "react-native-anything-player",
  "version": "1.2.0",
  "description": "Native-first, reliable audio player for React Native: files, streams and internet radio (ICY), with background playback, media sessions and automatic recovery.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "bin": {
    "react-native-anything-player": "lib/cli/rnap.mjs",
    "rnap": "lib/cli/rnap.mjs"
  },
  "exports": {
    ".": {
      "react-native-anything-player-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./web": {
      "react-native-anything-player-source": "./src/web/index.ts",
      "types": "./lib/typescript/src/web/index.d.ts",
      "default": "./lib/module/web/index.js"
    },
    "./react": {
      "react-native-anything-player-source": "./src/react/index.ts",
      "types": "./lib/typescript/src/react/index.d.ts",
      "default": "./lib/module/react/index.js"
    },
    "./sound": {
      "react-native": {
        "react-native-anything-player-source": "./src/sound/index.ts",
        "types": "./lib/typescript/src/sound/index.d.ts",
        "default": "./lib/module/sound/index.js"
      },
      "react-native-anything-player-source": "./src/sound/web.ts",
      "types": "./lib/typescript/src/sound/web.d.ts",
      "default": "./lib/module/sound/web.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "!lib/typescript/src/web/engine",
    "!lib/typescript/src/web/platform",
    "src/native/**",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "app.plugin.js",
    "plugin",
    "LICENSE",
    "COMMERCIAL.md",
    "!ios/Tests",
    "!ios/Package.swift",
    "!ios/.build",
    "!android/src/test"
  ],
  "scripts": {
    "example": "yarn workspace react-native-anything-player-example",
    "docs": "yarn workspace react-native-anything-player-website dev",
    "docs:build": "yarn workspace react-native-anything-player-website build",
    "docs:api": "typedoc",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build && node scripts/check-lib.mjs && node scripts/build-cli.mjs",
    "typecheck": "tsc && tsc -p e2e && tsc -p example-react",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --max-warnings 0",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ios": "cd ios && swift test",
    "test:android": "cd example/android && ./gradlew :react-native-anything-player:testDebugUnitTest",
    "check:audit": "node scripts/check-dependency-audit.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:web": "bash scripts/build-expo-web.sh && vite build example-react --logLevel warn && playwright test -c e2e",
    "test:tooling": "node --test scripts/__tests__/*.test.mjs",
    "doctor:gate": "node scripts/react-doctor-gate.mjs",
    "check:ci": "yarn run check:secrets && yarn run check:quality",
    "check:quality": "yarn run prepare && yarn run test:tooling && yarn run check:audit && yarn run lint && yarn run typecheck && yarn run docs:api && yarn run test:coverage && yarn run doctor:gate",
    "doctor": "react-doctor"
  },
  "keywords": [
    "react-native",
    "audio",
    "player",
    "radio",
    "icy",
    "shoutcast",
    "icecast",
    "streaming",
    "media-session",
    "background-audio",
    "ios",
    "android",
    "expo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmotafreitas/react-native-anything-player.git"
  },
  "author": "Ricardo Freitas <rmotafreitas@gmail.com> (https://rmotafreitas.dev)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "bugs": {
    "url": "https://github.com/rmotafreitas/react-native-anything-player/issues"
  },
  "homepage": "https://github.com/rmotafreitas/react-native-anything-player#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/parser": "^7.29.9",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19",
    "del-cli": "^8.0.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-sonarjs": "^4.2.1",
    "hermes-eslint": "0.37.0",
    "hls.js": "^1.7.3",
    "jest": "^30",
    "jest-junit": "^17.0.0",
    "prettier": "^3.9.10",
    "react": "19.2.3",
    "react-doctor": "0.9.18",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.2",
    "test-renderer": "1.2.0",
    "turbo": "^2.11.8",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^6.0.3",
    "vite": "6.4.4"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": ">=0.80.0"
  },
  "workspaces": [
    "example",
    "website"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true,
          "configFile": true,
          "sourceMaps": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "AnythingPlayerSpec",
    "type": "all",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.anythingplayer"
    },
    "ios": {
      "modulesProvider": {
        "AnythingPlayer": "AnythingPlayerModule",
        "AnythingPlayerSound": "AnythingPlayerSoundModule"
      },
      "componentProvider": {
        "RNAPRoutePickerView": "RNAPRoutePickerView"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.1"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "resolutions": {
    "eslint-plugin-ft-flow": "3.0.11",
    "vitepress/vite": "6.4.4",
    "source-map-js": "1.2.2",
    "braces": "patch:braces@npm%3A3.0.3#./.yarn/patches/braces-security.patch",
    "sprintf-js": "patch:sprintf-js@npm%3A1.0.3#./.yarn/patches/sprintf-js-security.patch"
  }
}
