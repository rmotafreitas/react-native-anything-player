{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".yarnrc.yml"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build:android": {
      "env": [
        "ANDROID_HOME",
        "ORG_GRADLE_PROJECT_newArchEnabled",
        "CI_NATIVE_TOOLCHAIN",
        "ImageVersion"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/android/**",
        "$TURBO_ROOT$/*.podspec",
        "!$TURBO_ROOT$/android/build/**",
        "!$TURBO_ROOT$/ios/.build/**",
        "!android/.gradle/**",
        "!android/build/**",
        "!android/app/build/**",
        "!ios/build/**",
        "!ios/Pods/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE",
        "RNAP_CAST",
        "RNAP_CAR",
        "RNAP_SOUND",
        "RNAP_VIDEO",
        "CI_NATIVE_TOOLCHAIN",
        "ImageVersion"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/src/**",
        "$TURBO_ROOT$/ios/**",
        "$TURBO_ROOT$/*.podspec",
        "!$TURBO_ROOT$/android/build/**",
        "!$TURBO_ROOT$/ios/.build/**",
        "!android/.gradle/**",
        "!android/build/**",
        "!android/app/build/**",
        "!ios/build/**",
        "!ios/Pods/**"
      ],
      "outputs": []
    }
  }
}
