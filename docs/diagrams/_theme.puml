' Shared look for every RNAP diagram: white background (legible on light
' and dark pages alike), system sans, warm hairlines, the brand's orange tints.
' Rendered (PlantUML + Graphviz) by
'   node scripts/render-diagrams.mjs
' Text is measured with Liberation Sans (metric-compatible with Arial); the
' script then gives the SVGs an Arial / Helvetica / sans-serif font stack.
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Liberation Sans"
skinparam defaultFontSize 13
skinparam defaultFontColor #351512
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #6B4A45
skinparam ArrowFontColor #6B4A45
skinparam ArrowFontSize 11
skinparam ArrowThickness 1.2

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #E2CBBF
  StereotypeFontColor #9A7F79
  StereotypeFontSize 11
}
skinparam component {
  BackgroundColor #FFF8F2
  BorderColor #E2CBBF
  StereotypeFontColor #9A7F79
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #E2CBBF
  FontColor #6B4A45
}
skinparam note {
  BackgroundColor #FFF8F2
  BorderColor #F1E3DA
  FontColor #6B4A45
  FontSize 11
}
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #E2CBBF
  FontStyle bold
  AttributeFontColor #6B4A45
  AttributeFontSize 11
  StartColor #351512
  EndColor #351512
}
skinparam sequence {
  LifeLineBorderColor #E2CBBF
  ParticipantBackgroundColor #FFF8F2
  ParticipantBorderColor #E2CBBF
  ParticipantFontStyle bold
  GroupBackgroundColor #FFF8F2
  GroupBorderColor #F1E3DA
  DividerBackgroundColor #FFF8F2
  DividerBorderColor #F1E3DA
  BoxBackgroundColor #FFFAF6
  BoxBorderColor #F1E3DA
}
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #E2CBBF
  DiamondBackgroundColor #FFF8F2
  DiamondBorderColor #E2CBBF
}
