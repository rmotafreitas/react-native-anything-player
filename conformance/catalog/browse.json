{
  "segments": [
    { "group": "Jazz", "segments": ["Jazz"] },
    { "group": "Podcasts/Daily", "segments": ["Podcasts", "Daily"] },
    { "group": "  Podcasts / Daily  ", "segments": ["Podcasts", "Daily"] },
    { "group": "Jazz//Cool/", "segments": ["Jazz", "Cool"] },
    { "group": "/", "segments": [] },
    { "group": "", "segments": [] },
    { "group": "   ", "segments": [] },
    { "group": "jazz", "segments": ["jazz"] },
    { "group": "Rock & Roll/Ünïcode", "segments": ["Rock & Roll", "Ünïcode"] }
  ],
  "membership": [
    { "itemGroup": "Podcasts/Daily", "group": "Podcasts", "in": true },
    { "itemGroup": "Podcasts/Daily", "group": "Podcasts/Daily", "in": true },
    { "itemGroup": "Podcasts", "group": "Podcasts/Daily", "in": false },
    { "itemGroup": "Podcasts/Weekly", "group": "Podcasts/Daily", "in": false },
    { "itemGroup": "Podcasts Extra", "group": "Podcasts", "in": false },
    { "itemGroup": " Podcasts /Daily", "group": "Podcasts/", "in": true },
    { "itemGroup": "jazz", "group": "Jazz", "in": false },
    { "itemGroup": null, "group": "Jazz", "in": false },
    { "itemGroup": "Jazz", "group": null, "in": true },
    { "itemGroup": null, "group": "", "in": true },
    { "itemGroup": "Jazz", "group": " / ", "in": true }
  ],
  "search": {
    "catalog": [
      { "id": "jazz-fm", "title": "Radio Jazz", "kind": "station", "group": "Music/Jazz" },
      { "id": "jazz-pod", "title": "Radio Jazz Talk", "kind": "podcast", "group": "Podcasts/Daily" },
      { "id": "jazz-loose", "title": "Radio Jazz Classics", "kind": "station" }
    ],
    "cases": [
      { "name": "no group searches everything", "request": { "query": "radio jazz" }, "expect": ["jazz-fm", "jazz-pod", "jazz-loose"] },
      { "name": "a group keeps its items", "request": { "query": "radio jazz", "group": "Podcasts" }, "expect": ["jazz-pod"] },
      { "name": "a subgroup", "request": { "query": "radio jazz", "group": "Music/Jazz" }, "expect": ["jazz-fm"] },
      { "name": "a parent group includes its subgroups", "request": { "query": "radio jazz", "group": "Music" }, "expect": ["jazz-fm"] },
      { "name": "a group with no items matches nothing", "request": { "query": "radio jazz", "group": "Nothing" }, "expect": [] },
      { "name": "a blank group is no filter", "request": { "query": "radio jazz", "group": " / " }, "expect": ["jazz-fm", "jazz-pod", "jazz-loose"] }
    ]
  },
  "trees": [
    {
      "name": "no groups: a flat list of stations is a grid",
      "items": [
        { "id": "a", "title": "A", "kind": "station" },
        { "id": "b", "title": "B", "kind": "album" }
      ],
      "children": { "rnap:root": [["item", "a", "A"], ["item", "b", "B"]] },
      "styles": { "rnap:root": "grid" }
    },
    {
      "name": "no groups: a song makes the list a list",
      "items": [
        { "id": "a", "title": "A", "kind": "station" },
        { "id": "b", "title": "B", "kind": "song" }
      ],
      "children": { "rnap:root": [["item", "a", "A"], ["item", "b", "B"]] },
      "styles": { "rnap:root": "list" }
    },
    {
      "name": "an empty catalog has an empty root",
      "items": [],
      "children": { "rnap:root": [] }
    },
    {
      "name": "groups become tabs, nested groups folders, ungrouped items More",
      "items": [
        { "id": "jazz", "title": "Jazz FM", "kind": "station", "group": "Jazz" },
        { "id": "rock", "title": "Rock FM", "kind": "station", "group": "Rock" },
        { "id": "news", "title": "News", "kind": "podcast", "group": "Podcasts/Daily" },
        { "id": "weekly", "title": "Weekly", "kind": "podcast", "group": "Podcasts/Weekly" },
        { "id": "intro", "title": "Intro", "kind": "podcast", "group": "Podcasts" },
        { "id": "loose", "title": "Loose", "kind": "song" }
      ],
      "children": {
        "rnap:root": [
          ["folder", "rnap:group:Jazz", "Jazz"],
          ["folder", "rnap:group:Rock", "Rock"],
          ["folder", "rnap:group:Podcasts", "Podcasts"],
          ["folder", "rnap:more", "More"]
        ],
        "rnap:group:Jazz": [["item", "jazz", "Jazz FM"]],
        "rnap:group:Podcasts": [
          ["folder", "rnap:group:Podcasts/Daily", "Daily"],
          ["folder", "rnap:group:Podcasts/Weekly", "Weekly"],
          ["item", "intro", "Intro"]
        ],
        "rnap:group:Podcasts/Daily": [["item", "news", "News"]],
        "rnap:more": [["item", "loose", "Loose"]]
      },
      "styles": {
        "rnap:group:Jazz": "grid",
        "rnap:group:Podcasts": "list",
        "rnap:group:Podcasts/Daily": "list",
        "rnap:more": "list"
      },
      "missing": ["rnap:group:Nothing", "rnap:group:Jazz/Cool", "ghost", "rnap:recent", "rnap:favorites"]
    },
    {
      "name": "rootOrder puts the named groups first; unknown names are ignored",
      "items": [
        { "id": "jazz", "title": "Jazz FM", "group": "Jazz" },
        { "id": "rock", "title": "Rock FM", "group": "Rock" },
        { "id": "pod", "title": "Pod", "group": "Podcasts/Daily" }
      ],
      "options": { "rootOrder": ["Rock", "Missing", "Podcasts/Daily", "Rock"] },
      "children": {
        "rnap:root": [
          ["folder", "rnap:group:Rock", "Rock"],
          ["folder", "rnap:group:Podcasts", "Podcasts"],
          ["folder", "rnap:group:Jazz", "Jazz"]
        ]
      }
    },
    {
      "name": "recent and favorites come first and only hold items still there",
      "items": [
        { "id": "jazz", "title": "Jazz FM", "group": "Jazz" },
        { "id": "rock", "title": "Rock FM", "group": "Rock" },
        { "id": "loose", "title": "Loose" }
      ],
      "options": { "recentLimit": 2, "favorites": ["rock", "ghost", "rock", "jazz"] },
      "recent": ["loose", "ghost", "jazz", "rock", "loose"],
      "children": {
        "rnap:root": [
          ["folder", "rnap:recent", "Recently played"],
          ["folder", "rnap:favorites", "Favorites"],
          ["folder", "rnap:group:Jazz", "Jazz"],
          ["folder", "rnap:more", "More"]
        ],
        "rnap:more": [["folder", "rnap:group:Rock", "Rock"], ["item", "loose", "Loose"]],
        "rnap:recent": [["item", "loose", "Loose"], ["item", "jazz", "Jazz FM"]],
        "rnap:favorites": [["item", "rock", "Rock FM"], ["item", "jazz", "Jazz FM"]]
      }
    },
    {
      "name": "recent off, or nothing played yet, adds no folder; no favorites adds none",
      "items": [{ "id": "jazz", "title": "Jazz FM", "group": "Jazz" }],
      "options": { "recentLimit": 0, "favorites": ["ghost"] },
      "recent": ["jazz"],
      "children": { "rnap:root": [["folder", "rnap:group:Jazz", "Jazz"]] },
      "missing": ["rnap:recent", "rnap:favorites"]
    },
    {
      "name": "more tabs than a car shows: the last tab is More and holds the rest",
      "items": [
        { "id": "a", "title": "A", "group": "One" },
        { "id": "b", "title": "B", "group": "Two" },
        { "id": "c", "title": "C", "group": "Three" },
        { "id": "d", "title": "D", "group": "Four" },
        { "id": "e", "title": "E", "group": "Five" },
        { "id": "f", "title": "F" }
      ],
      "children": {
        "rnap:root": [
          ["folder", "rnap:group:One", "One"],
          ["folder", "rnap:group:Two", "Two"],
          ["folder", "rnap:group:Three", "Three"],
          ["folder", "rnap:more", "More"]
        ],
        "rnap:more": [
          ["folder", "rnap:group:Four", "Four"],
          ["folder", "rnap:group:Five", "Five"],
          ["item", "f", "F"]
        ],
        "rnap:group:Five": [["item", "e", "E"]]
      }
    },
    {
      "name": "exactly as many tabs as fit, and none left over, needs no More",
      "items": [
        { "id": "a", "title": "A", "group": "One" },
        { "id": "b", "title": "B", "group": "Two" },
        { "id": "c", "title": "C", "group": "Three" },
        { "id": "d", "title": "D", "group": "Four" }
      ],
      "children": {
        "rnap:root": [
          ["folder", "rnap:group:One", "One"],
          ["folder", "rnap:group:Two", "Two"],
          ["folder", "rnap:group:Three", "Three"],
          ["folder", "rnap:group:Four", "Four"]
        ]
      },
      "missing": ["rnap:more"]
    },
    {
      "name": "a smaller root limit moves more into More",
      "items": [
        { "id": "a", "title": "A", "group": "One" },
        { "id": "b", "title": "B", "group": "Two" },
        { "id": "c", "title": "C", "group": "Three" }
      ],
      "options": { "rootLimit": 2 },
      "children": {
        "rnap:root": [["folder", "rnap:group:One", "One"], ["folder", "rnap:more", "More"]],
        "rnap:more": [["folder", "rnap:group:Two", "Two"], ["folder", "rnap:group:Three", "Three"]]
      }
    },
    {
      "name": "a browser that wants folders only gets a flat catalog under More",
      "items": [
        { "id": "a", "title": "A", "kind": "station" },
        { "id": "b", "title": "B", "kind": "station" }
      ],
      "options": { "foldersOnly": true },
      "children": {
        "rnap:root": [["folder", "rnap:more", "More"]],
        "rnap:more": [["item", "a", "A"], ["item", "b", "B"]]
      },
      "styles": { "rnap:more": "grid" }
    },
    {
      "name": "titles can be renamed; blank segments are dropped; groups are case-sensitive",
      "items": [
        { "id": "a", "title": "A", "group": " Jazz / " },
        { "id": "b", "title": "B", "group": "Jazz//Cool" },
        { "id": "c", "title": "C", "group": "jazz" },
        { "id": "d", "title": "D" }
      ],
      "options": { "recentLimit": 1, "favorites": ["a"], "titles": { "recent": "Zuletzt", "favorites": "Favoriten", "more": "Mehr" } },
      "recent": ["d"],
      "children": {
        "rnap:root": [
          ["folder", "rnap:recent", "Zuletzt"],
          ["folder", "rnap:favorites", "Favoriten"],
          ["folder", "rnap:group:Jazz", "Jazz"],
          ["folder", "rnap:more", "Mehr"]
        ],
        "rnap:more": [["folder", "rnap:group:jazz", "jazz"], ["item", "d", "D"]],
        "rnap:group:Jazz": [["folder", "rnap:group:Jazz/Cool", "Cool"], ["item", "a", "A"]],
        "rnap:group:Jazz/Cool": [["item", "b", "B"]]
      }
    },
    {
      "name": "a folder shows the artwork of the first item inside",
      "items": [
        { "id": "a", "title": "A", "group": "Pods/Daily" },
        { "id": "b", "title": "B", "group": "Pods/Daily", "artwork": "https://x/b.png" },
        { "id": "c", "title": "C", "group": "Pods", "artwork": "https://x/c.png" },
        { "id": "d", "title": "D", "group": "Bare" }
      ],
      "children": {
        "rnap:root": [["folder", "rnap:group:Pods", "Pods"], ["folder", "rnap:group:Bare", "Bare"]]
      },
      "artworks": {
        "rnap:group:Pods": "https://x/b.png",
        "rnap:group:Pods/Daily": "https://x/b.png",
        "rnap:group:Bare": null,
        "b": "https://x/b.png",
        "a": null
      }
    },
    {
      "name": "a catalog id that starts with rnap: is left out, so a media id is never a folder and an item",
      "items": [
        { "id": "rnap:group:Jazz", "title": "Impostor", "group": "Jazz" },
        { "id": "rnap:more", "title": "Lookalike" },
        { "id": "ok", "title": "Fine", "group": "Jazz" }
      ],
      "children": { "rnap:group:Jazz": [["item", "ok", "Fine"]], "rnap:root": [["folder", "rnap:group:Jazz", "Jazz"]] },
      "missing": ["rnap:more"]
    },
    {
      "name": "a folder with more children than the limit is split into slices, and a long slice again",
      "items": [
        { "id": "g0", "title": "G0", "group": "G" },
        { "id": "g1", "title": "G1", "group": "G" },
        { "id": "g2", "title": "G2", "group": "G" },
        { "id": "g3", "title": "G3", "group": "G" },
        { "id": "g4", "title": "G4", "group": "G" }
      ],
      "options": { "folderLimit": 2 },
      "children": {
        "rnap:root": [["folder", "rnap:group:G", "G"]],
        "rnap:group:G": [["folder", "rnap:part:1-4:rnap:group:G", "1–4"], ["folder", "rnap:part:5-5:rnap:group:G", "5"]],
        "rnap:part:1-4:rnap:group:G": [["folder", "rnap:part:1-2:rnap:part:1-4:rnap:group:G", "1–2"], ["folder", "rnap:part:3-4:rnap:part:1-4:rnap:group:G", "3–4"]],
        "rnap:part:1-2:rnap:part:1-4:rnap:group:G": [["item", "g0", "G0"], ["item", "g1", "G1"]],
        "rnap:part:3-4:rnap:part:1-4:rnap:group:G": [["item", "g2", "G2"], ["item", "g3", "G3"]],
        "rnap:part:5-5:rnap:group:G": [["item", "g4", "G4"]]
      },
      "styles": { "rnap:part:1-2:rnap:part:1-4:rnap:group:G": "grid", "rnap:part:1-4:rnap:group:G": "list" }
    },
    {
      "name": "slices are numbered by position in the whole folder, at every depth",
      "items": [
        { "id": "h0", "title": "H0", "group": "H" },
        { "id": "h1", "title": "H1", "group": "H" },
        { "id": "h2", "title": "H2", "group": "H" },
        { "id": "h3", "title": "H3", "group": "H" },
        { "id": "h4", "title": "H4", "group": "H" },
        { "id": "h5", "title": "H5", "group": "H" },
        { "id": "h6", "title": "H6", "group": "H" },
        { "id": "h7", "title": "H7", "group": "H" },
        { "id": "h8", "title": "H8", "group": "H" }
      ],
      "options": { "folderLimit": 2 },
      "children": {
        "rnap:group:H": [["folder", "rnap:part:1-8:rnap:group:H", "1–8"], ["folder", "rnap:part:9-9:rnap:group:H", "9"]],
        "rnap:part:1-8:rnap:group:H": [["folder", "rnap:part:1-4:rnap:part:1-8:rnap:group:H", "1–4"], ["folder", "rnap:part:5-8:rnap:part:1-8:rnap:group:H", "5–8"]],
        "rnap:part:5-8:rnap:part:1-8:rnap:group:H": [["folder", "rnap:part:5-6:rnap:part:5-8:rnap:part:1-8:rnap:group:H", "5–6"], ["folder", "rnap:part:7-8:rnap:part:5-8:rnap:part:1-8:rnap:group:H", "7–8"]],
        "rnap:part:7-8:rnap:part:5-8:rnap:part:1-8:rnap:group:H": [["item", "h6", "H6"], ["item", "h7", "H7"]]
      }
    },
    {
      "name": "a folder with exactly the limit is not split; the tab bar is never split",
      "items": [
        { "id": "a", "title": "A", "group": "One" },
        { "id": "b", "title": "B", "group": "One" },
        { "id": "c", "title": "C", "group": "One" },
        { "id": "d", "title": "D", "group": "Two" },
        { "id": "e", "title": "E", "group": "Three" }
      ],
      "options": { "folderLimit": 3, "rootLimit": 2, "foldersOnly": true },
      "children": {
        "rnap:root": [["folder", "rnap:group:One", "One"], ["folder", "rnap:more", "More"]],
        "rnap:group:One": [["item", "a", "A"], ["item", "b", "B"], ["item", "c", "C"]],
        "rnap:more": [["folder", "rnap:group:Two", "Two"], ["folder", "rnap:group:Three", "Three"]]
      }
    },
    {
      "name": "a flat root (a browser not limited to folders) is split too",
      "items": [
        { "id": "a", "title": "A" },
        { "id": "b", "title": "B" },
        { "id": "c", "title": "C" }
      ],
      "options": { "folderLimit": 2 },
      "children": {
        "rnap:root": [["folder", "rnap:part:1-2:rnap:root", "1–2"], ["folder", "rnap:part:3-3:rnap:root", "3"]],
        "rnap:part:1-2:rnap:root": [["item", "a", "A"], ["item", "b", "B"]],
        "rnap:part:3-3:rnap:root": [["item", "c", "C"]]
      }
    },
    {
      "name": "a folder holding subfolders and items is split by position, subfolders first",
      "items": [
        { "id": "x", "title": "X", "group": "P/Q" },
        { "id": "y", "title": "Y", "group": "P/R" },
        { "id": "z", "title": "Z", "group": "P" }
      ],
      "options": { "folderLimit": 2 },
      "children": {
        "rnap:group:P": [["folder", "rnap:part:1-2:rnap:group:P", "1–2"], ["folder", "rnap:part:3-3:rnap:group:P", "3"]],
        "rnap:part:1-2:rnap:group:P": [["folder", "rnap:group:P/Q", "Q"], ["folder", "rnap:group:P/R", "R"]],
        "rnap:part:3-3:rnap:group:P": [["item", "z", "Z"]]
      }
    },
    {
      "name": "no limit never splits",
      "items": [
        { "id": "a", "title": "A", "group": "G" },
        { "id": "b", "title": "B", "group": "G" },
        { "id": "c", "title": "C", "group": "G" }
      ],
      "children": { "rnap:group:G": [["item", "a", "A"], ["item", "b", "B"], ["item", "c", "C"]] },
      "missing": ["rnap:part:1-2:rnap:group:G"]
    }
  ]
}
