{
  "catalog": [
    { "id": "bbc1", "title": "BBC Radio 1", "artist": "BBC", "genre": "Pop", "keywords": ["Radio One", "BBC One"], "kind": "station" },
    { "id": "jazzfm", "title": "Jazz FM", "genre": "Jazz", "kind": "station" },
    { "id": "kexp", "title": "KEXP", "artist": "KEXP Seattle", "genre": "Indie", "keywords": ["K E X P"], "kind": "station" },
    { "id": "cafe", "title": "Café del Mar", "genre": "Chillout", "kind": "station" },
    { "id": "song-hello", "title": "Hello", "artist": "Adele", "album": "25", "kind": "song" },
    { "id": "hello-radio", "title": "Hello Radio", "genre": "Talk", "kind": "station" },
    { "id": "pod-daily", "title": "The Daily", "artist": "The New York Times", "kind": "podcast" },
    { "id": "radio", "title": "Radio" },
    { "id": "jazz24", "title": "Jazz24", "genre": "Jazz", "kind": "station" },
    { "id": "smooth", "title": "Smooth Jazz", "genre": "Jazz" },
    { "id": "istanbul", "title": "İstanbul FM", "kind": "station" }
  ],
  "cases": [
    { "name": "exact title", "request": { "query": "BBC Radio 1" }, "expect": ["bbc1"] },
    { "name": "a keyword after a leading filler", "request": { "query": "play radio one" }, "expect": ["bbc1"] },
    { "name": "title prefix beats a loose match and a genre", "request": { "query": "jazz" }, "expect": ["jazzfm", "smooth", "jazz24"] },
    { "name": "trailing 'radio' is dropped only as a variant", "request": { "query": "jazz radio" }, "expect": ["jazzfm", "smooth", "jazz24"] },
    { "name": "'play the radio' still finds a station called Radio", "request": { "query": "play the radio" }, "expect": ["radio", "bbc1", "hello-radio"] },
    { "name": "only a filler word is an empty query", "request": { "query": "play" }, "expect": [], "emptyQuery": true },
    { "name": "an empty query", "request": { "query": "" }, "expect": [], "emptyQuery": true },
    { "name": "'station' alone is an empty query", "request": { "query": "station" }, "expect": [], "emptyQuery": true },
    { "name": "accents are ignored", "request": { "query": "cafe del mar" }, "expect": ["cafe"] },
    { "name": "case and accents are ignored", "request": { "query": "CAFÉ DEL MAR" }, "expect": ["cafe"] },
    { "name": "exact title beats an artist prefix", "request": { "query": "kexp" }, "expect": ["kexp"] },
    { "name": "one typo in a long word", "request": { "query": "kexpp" }, "expect": ["kexp"] },
    { "name": "no typo tolerance under five letters", "request": { "query": "kexq" }, "expect": [] },
    { "name": "exact title, then a title prefix", "request": { "query": "hello" }, "expect": ["song-hello", "hello-radio"] },
    { "name": "focus keeps the matching kind", "request": { "query": "hello", "focus": "station" }, "expect": ["hello-radio"] },
    { "name": "focus is ignored when nothing of that kind matches", "request": { "query": "hello", "focus": "podcast" }, "expect": ["song-hello", "hello-radio"] },
    { "name": "structured artist only", "request": { "query": "", "artist": "Adele" }, "expect": ["song-hello"] },
    { "name": "a structured match adds a bonus", "request": { "query": "hello", "artist": "adele" }, "expect": ["song-hello", "hello-radio"] },
    { "name": "a structured title bonus does not overturn an exact title", "request": { "query": "hello", "title": "hello radio" }, "expect": ["song-hello", "hello-radio"] },
    { "name": "'the' is kept when it is part of the title", "request": { "query": "the daily" }, "expect": ["pod-daily"] },
    { "name": "exact artist", "request": { "query": "the new york times" }, "expect": ["pod-daily"] },
    { "name": "a single word title, keyword prefix, title tokens", "request": { "query": "radio" }, "expect": ["radio", "bbc1", "hello-radio"] },
    { "name": "equal scores keep catalog order", "request": { "query": "", "genre": "jazz" }, "expect": ["jazzfm", "jazz24", "smooth"] },
    { "name": "listen to", "request": { "query": "listen to kexp" }, "expect": ["kexp"] },
    { "name": "leading and trailing fillers together", "request": { "query": "put on jazz fm radio" }, "expect": ["jazzfm"] },
    { "name": "an artist token clears the threshold", "request": { "query": "seattle" }, "expect": ["kexp"] },
    { "name": "exact album", "request": { "query": "25" }, "expect": ["song-hello"] },
    { "name": "a loose genre match stays under the threshold", "request": { "query": "chill" }, "expect": [] },
    { "name": "repeated tokens may reuse a field token", "request": { "query": "jazz jazz" }, "expect": ["jazzfm", "smooth", "jazz24"] },
    { "name": "dotted capital I in the catalog", "request": { "query": "istanbul fm" }, "expect": ["istanbul"] },
    { "name": "upper-case query", "request": { "query": "ISTANBUL" }, "expect": ["istanbul"] },
    { "name": "dotless i in the query", "request": { "query": "ıstanbul" }, "expect": ["istanbul"] },
    { "name": "a structured field that matches nothing is not an empty query", "request": { "query": "", "genre": "polka" }, "expect": [] }
  ]
}
