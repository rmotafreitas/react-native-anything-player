  {
    "name": "video: an ambient player plays only while shown, resumes when shown again, and never asks for focus",
    "options": { "video": { "ambient": true } },
    "steps": [
      { "focus": "denied" },
      { "call": "loop", "value": true },
      { "call": "load", "uri": "https://cdn.example/loop.mp4", "autoplay": true },
      { "expect": { "state": "loading", "playWhenReady": false, "interruption": "offscreen", "interruptionResumable": true, "needsAudioFocus": false, "wantsMediaSession": false, "commands": ["loop(true)", "open(gen=1,start=-,play=false)", "quality(maxH=-,maxBps=-,pin=-,audioOnly=false)"] } },
      { "native": "ready", "duration": 10, "seekable": true },
      { "expect": { "state": "paused" } },
      { "view": {} },
      { "expect": { "state": "buffering", "playWhenReady": true, "interruption": null, "commands": ["play"] } },
      { "native": "playing" },
      { "expect": { "state": "playing", "wantsScreenAwake": false, "needsAudioFocus": false } },
      { "view": { "visible": false } },
      { "expect": { "state": "paused", "interruption": "offscreen", "interruptionResumable": true, "commands": ["pause"] } },
      { "view": {} },
      { "expect": { "state": "buffering", "interruption": null, "commands": ["play"] } },
      { "native": "playing" },
      { "call": "background" },
      { "expect": { "state": "paused", "interruption": "background", "interruptionResumable": true, "commands": ["pause"] } },
      { "call": "foreground" },
      { "expect": { "state": "buffering", "interruption": null, "commands": ["play"] } },
      { "native": "playing" },
      { "call": "pause" },
      { "call": "play" },
      { "expect": { "state": "buffering", "playWhenReady": true, "interruption": null } }
    ]
  },
