[
  {
    "name": "video: the background pauses a video player (whenBackgrounded pause), and nothing resumes it",
    "options": { "video": true },
    "steps": [
      { "view": {} },
      { "call": "load", "uri": "https://cdn.example/v.m3u8", "autoplay": true },
      { "native": "ready", "duration": 120, "seekable": true },
      { "native": "playing" },
      { "expect": { "state": "playing", "wantsMediaSession": true, "commands": ["open(gen=1,start=-,play=true)", "quality(maxH=-,maxBps=-,pin=-,audioOnly=false)"] } },
      { "call": "background" },
      { "expect": { "state": "paused", "playWhenReady": false, "interruption": "background", "interruptionResumable": false, "commands": ["pause"] } },
      { "call": "foreground" },
      { "expect": { "state": "paused", "interruption": "background", "commands": [] } },
      { "call": "play" },
      { "expect": { "state": "buffering", "playWhenReady": true, "interruption": null, "commands": ["play"] } }
    ]
  },
  {
    "name": "video: an audio player ignores the background and has no video status",
